# Copy this file to ".env" and fill in the values. ".env" is git-ignored.
# Keys use "__" for nesting, e.g. Auth__RegistrationKey = Auth:RegistrationKey.
# Values here override appsettings.json. Real environment variables override .env.

# Database
ConnectionStrings__DefaultConnection='Server=(localdb)\MSSQLLocalDB;Database=AdvancedOrderDb;Trusted_Connection=True;TrustServerCertificate=True;'

# Frontend origin allowed by CORS (add more with __1, __2, ...)
Cors__AllowedOrigins__0=http://localhost:4200

# Auth - the key an admin must enter to sign up.
# Generate one with: openssl rand -base64 36
Auth__RegistrationKey=
Auth__MaxFailedLoginAttempts=5
Auth__LockoutMinutes=15
# The first admin account is confirmed automatically
Auth__AutoConfirmFirstAdmin=true

# Where confirmation and password reset links point
Frontend__BaseUrl=http://localhost:4200

# Email. Leave Password empty to log emails to the terminal instead of sending them.
# For Gmail this must be a 16-character App Password, not the account password.
Email__Provider=Smtp
Email__Host=smtp.gmail.com
Email__Port=587
Email__User=
Email__Password=
Email__FromAddress=
Email__FromName='Advanced Order System'

# Google sign-in for customers (optional). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with the redirect URI
# http://localhost:5264/api/auth/google/callback
Google__ClientId=
Google__ClientSecret=
